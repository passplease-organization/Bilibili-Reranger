// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
  "name": "C++",
  dockerComposeFile: "docker-compose.yml",
  service: "backend",
  //  "build": {
//    "dockerfile": "Dockerfile"
//  },
//  "runArgs": [
//    "--name","Bilibili-Backend-devcontainer","--env-file","${localWorkspaceFolder}/.devcontainer/.env"
//  ],
  // Features to add to the dev container. More info: https://containers.dev/features.
//	 "features": {
//       "ghcr.io/devcontainers/features/node:1": {
//         "version": "22"
//       }
//     },

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
//	 "forwardPorts": [23223],

	// Use 'postCreateCommand' to run commands after the container is created.
//	 "postCreateCommand": "npm install -g @google/gemini-cli",

	// Configure tool-specific properties.
  "customizations" : {
    "jetbrains" : {
      "backend" : "CLion",
      "settings": {
        "com.intellij:app:BaseRefactoringSettings.rename_search_in_comments_for_file": false,
        "com.intellij:app:GeneralSettings.autoSaveIfInactive": true,
        "com.intellij:app:GeneralSettings.inactiveTimeout": 60,
        "com.intellij:app:EditorSettings.soft_wrap_file_masks": "*.md; *.txt; *.rst; *.adoc; *.list",
        "com.intellij:app:BuiltInServerOptions.builtInServerPort": 59617,
        "com.intellij:app:HttpConfigurable.use_proxy_pac": true
      },
      "plugins": [
        "cn.memoryzy.json",
        "com.intellij.ml.llm",
        "codex-brain"
      ]
    }
  }

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
